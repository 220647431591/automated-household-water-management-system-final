# ============================================================
# Backend environment file. Copy this to Backend/.env and fill in
# real values, OR set these as real process/server environment
# variables (Apache SetEnv, Docker, systemd, cPanel) — those always
# take precedence over Backend/.env if both are present.
#
# Backend/.env itself is gitignored — never commit real credentials.
# ============================================================

# ---- Database ----
DB_HOST=127.0.0.1
DB_NAME=water_management
DB_USER=root
DB_PASS=

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- App mode ----
# dev = extra debug info (e.g. dev_reset_link in forgot_password.php response)
# prod = disables that debug info. Always use prod on a public deployment.
APP_ENV=dev

# ---- Email: Gmail SMTP (free) ----
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:     https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password as SMTP_PASS (not your real Gmail password).
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME="Water Management System"

# Fallback base URL for password-reset links when a request has no Origin
# header (Postman, server-to-server, some mobile clients). Optional.
FRONTEND_URL=https://your-domain.com

# ---- Hardware ----
# Shared secret the ESP32 sends as the X-Device-Token header.
DEVICE_INGEST_TOKEN=change-me-to-a-long-random-string
