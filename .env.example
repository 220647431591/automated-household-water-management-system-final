# ============================================================
# Environment variables for the Vercel API (api/*.ts).
#
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# For local development, copy this file to `.env` in the project root
# (Vercel CLI's `vercel dev` reads it automatically) -- never commit a real
# `.env` file.
# ============================================================

# ---- Database (required) ----
# Neon (https://neon.tech) free tier is what the deployment guide uses.
# Get this from Neon dashboard -> your project -> Connection string.
DATABASE_URL=postgres://user:password@your-neon-host/neondb?sslmode=require

# ---- Sessions (required) ----
# Any long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- CORS (optional) ----
# Only needed if the frontend is hosted on a different origin than the API
# (e.g. local dev with separate dev servers, or a custom-domain split
# deployment). Not needed when frontend + API are one Vercel project.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Email: Gmail SMTP (free) ----
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:     https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password as SMTP_PASS (not your real Gmail password).
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME="Water Management System"

# Alternative: set MAIL_DRIVER=resend and RESEND_API_KEY instead of the
# SMTP_* vars above if Gmail SMTP is ever unreliable from your Vercel
# region/plan. Free tier: https://resend.com (3,000 emails/month).
# RESEND_API_KEY=

# Fallback base URL for password-reset links when a request has no Origin
# header (Postman, server-to-server, some mobile clients). Optional.
FRONTEND_URL=https://your-app.vercel.app

# ---- Hardware (required for ESP32 ingestion) ----
# Shared secret the ESP32 sends as the X-Device-Token header.
# Generate one the same way as JWT_SECRET, above.
DEVICE_INGEST_TOKEN=change-me-to-a-long-random-string

# ---- Frontend build-time variable ----
# Leave unset for normal deployment (frontend calls same-origin /api/*).
# VITE_API_BASE_URL=
